PORT=5000
NODE_ENV=development
JWT_SECRET=canchapro_secret_jwt_key_2026_super_secure

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canchapro_db
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=canchapro_db
PG_USER=postgres
PG_PASSWORD=postgres

# Pasarelas de Pago
WOMPI_PUBLIC_KEY=pub_test_xxxx
WOMPI_PRIVATE_KEY=prv_test_xxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx

# WhatsApp API
WHATSAPP_API_TOKEN=EAAxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890

# MQTT / IoT para Relés de Iluminación
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_PREFIX=canchapro/lighting
