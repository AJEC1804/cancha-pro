# ============================================================
# CANCHA PRO — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Vercel Deployment & Supabase Cloud PostgreSQL
# ============================================================

# Supabase API (Panel de Supabase -> Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# Conexión directa a PostgreSQL Supabase (Pooler o Directa)
# Ejemplo: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:password@db.tu-proyecto.supabase.co:5432/postgres?sslmode=require

# Configuración del Servidor y JWT
PORT=5000
NODE_ENV=production
JWT_SECRET=canchapro_jwt_secret_super_seguro_2026_cartagena
